{
  "name": "test-turborepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "start-server": "cd server && npm start",
    "dev-all": "concurrently \"npm run dev\" \"npm run start-server\""
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "concurrently": "^8.2.2",
    "path": "^0.12.7",
    "turbo": "^1.13.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
