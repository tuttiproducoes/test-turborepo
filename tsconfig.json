{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",  // Alterado de ESNext para Node16
    "moduleResolution": "Node16",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "ui": ["./packages/ui/src/index.ts"],
      "ui/*": ["./packages/ui/src/*"],
      "@admin/*": ["./apps/admin/src/*"],  // Separado em paths específicos
      "@client/*": ["./apps/client/src/*"]
    }
  },
  "exclude": ["node_modules", "**/dist", "**/build"],
  "include": ["**/*.ts", "**/*.tsx"]
}